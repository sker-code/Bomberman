IOBUF  PORT "btn_left1" PULLMODE=DOWN IO_TYPE=LVCMOS33;
LOCATE COMP "btn_right1" SITE "H16";
IOBUF  PORT "btn_right1" PULLMODE=DOWN IO_TYPE=LVCMOS33;
LOCATE COMP "btn_up1" SITE "R18";
IOBUF  PORT "btn_up1" PULLMODE=DOWN IO_TYPE=LVCMOS33;
LOCATE COMP "btn_down1" SITE "V1";
IOBUF  PORT "btn_down1" PULLMODE=DOWN IO_TYPE=LVCMOS33;
LOCATE COMP "btn_bomb1" SITE "T1";
IOBUF  PORT "btn_bomb1" PULLMODE=DOWN IO_TYPE=LVCMOS33;

